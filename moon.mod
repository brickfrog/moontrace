name = "brickfrog/moontrace"

version = "0.14.0"

import {
  "moonbitlang/async@0.21.1",
  "moonbitlang/protobuf@0.1.2",
}

readme = "README.mbt.md"

repository = "https://github.com/brickfrog/moontrace"

license = "Apache-2.0"

keywords = [
  "tracing",
  "logging",
  "spans",
  "structured-logging",
  "observability",
]

description = "Structured tracing for MoonBit with spans, structured fields, pluggable subscribers."

preferred_target = "native"

source = "src"
